{
  "name": "bpdactivity",
  "keep_vars": true,
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "activity.banpadengschool.ac.th", "custom_domain": true }],
  // ACTIVITY_DRIVE_FOLDER_ID ตั้งใน Cloudflare dashboard (keep_vars) — ห้ามใส่ใน "vars" ที่นี่ ไม่งั้นค่าที่ตั้งไว้ถูกทับทุกครั้งที่ deploy
  // ใช้ฐานข้อมูลเดียวกับ system (บัญชีผู้ใช้ร่วมกัน) — ต้องประกาศในไฟล์นี้ ไม่งั้น binding หายทุกครั้งที่ deploy
  "d1_databases": [
    { "binding": "DB", "database_name": "banpadeng_school_db", "database_id": "870fa9ec-122f-4161-a1ca-cc9979dcfa30" }
  ]
}
