{
  "name": "bpdactivity",
  "keep_vars": true,
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // ซิงก์โฟลเดอร์/ภาพจาก Google Drive (src/sync.js)
  // ดาวน์โหลดอัลบั้มเป็น zip ใช้ CPU คำนวณ CRC — ขยายเพดาน CPU ต่อคำขอ (Workers Paid)
  "limits": { "cpu_ms": 300000 },
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [{ "pattern": "activity.banpadengschool.ac.th", "custom_domain": true }],
  "vars": {
    // โฟลเดอร์ "Photo" ใน Google Drive — ระบบสร้างโฟลเดอร์ย่อย "ชื่องาน (30 ต.ค. 2569)" ใต้โฟลเดอร์นี้
    "ACTIVITY_DRIVE_FOLDER_ID": "1cW8j6cDQrlS8xvl8uE3wOoaBWo48XOkZ"
  },
  // ใช้ฐานข้อมูลเดียวกับ system (บัญชีผู้ใช้ร่วมกัน) — ต้องประกาศในไฟล์นี้ ไม่งั้น binding หายทุกครั้งที่ deploy
  "d1_databases": [
    { "binding": "DB", "database_name": "banpadeng_school_db", "database_id": "870fa9ec-122f-4161-a1ca-cc9979dcfa30" }
  ]
}
